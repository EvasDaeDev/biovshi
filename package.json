    "test": "node --test",
    "textures": "node scripts/prepare-boss-textures.mjs && node scripts/prepare-textures.mjs",
    "prebuild": "npm run textures",
    "prestandalone": "npm run textures",
    "profile:ui": "node scripts/profile-ui.mjs",
