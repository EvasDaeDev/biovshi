{
  "name": "biovshi",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "predev": "node scripts/prepare-boss-textures.mjs",
    "experiment:boss": "node scripts/experiment-boss.mjs",
    "build": "vite build",
    "standalone": "node scripts/build-standalone.mjs",
