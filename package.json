  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "jsdom": "^31.0.0",
    "sharp": "^0.34.5",
    "vite": "^7.3.7"
